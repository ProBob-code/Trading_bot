# MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=trading_bot

# Admin Console (optional, but there is no other way to create the first admin)
# ---------------------------------------------------------------------------
# Accounts listed here are promoted to administrator at boot and can then reach
# /v2/admin — every user's report, the strategies they run, and the downloads.
#
# Two ways in, both idempotent and applied at boot:
#
#   ADMIN_USERNAME + ADMIN_PASSWORD  create a dedicated admin account if it is
#       missing, and refresh its password if it already exists. The account is
#       created with NO mobile number on purpose: the register flow finds an
#       account by mobile and overwrites its username/password on a successful
#       OTP, so an admin reachable by a known number could be taken over. With
#       no number, it can only be reached by username + password.
#
#   ADMIN_USERNAMES / ADMIN_MOBILES  promote accounts that already exist.
#       Comma-separated; match on username or registered mobile. Removing a name
#       here does NOT revoke the flag (that would lock someone out mid-deploy) —
#       revoke it from the console instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_USERNAMES=
ADMIN_MOBILES=

# Discord Daily Reports (optional)
# --------------------------------
# Leave DISCORD_BOT_TOKEN empty and reporting stays dormant; the app runs
# normally and the opt-in toggle tells users it is unavailable.
#
# Setup:
#   1. https://discord.com/developers/applications -> New Application -> Bot
#   2. Copy the bot token into DISCORD_BOT_TOKEN below (NEVER commit it)
#   3. OAuth2 -> URL Generator -> scope "bot", permissions
#      "Manage Channels" + "Send Messages" -> invite it to your server
#   4. DISCORD_GUILD_ID is your server id (enable Developer Mode in Discord,
#      right-click the server -> Copy Server ID)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1393915763588468767
DISCORD_REPORT_HOUR_UTC=21

# Angel One SmartAPI - live Indian market data (optional)
# ------------------------------------------------------
# Leave these empty and the app still runs: Indian instruments simply fall back
# to Yahoo Finance, which is roughly 15 minutes delayed and has no index or F&O
# coverage. Fill them in and NSE/BSE go real-time.
#
# Setup:
#   1. https://smartapi.angelone.in -> My Profile -> Create an App
#        - Redirect URL: your app URL (unused for server-side data, but required)
#        - Primary Static IP: the PUBLIC IP of the machine running this server.
#          Angel One rejects requests from unregistered addresses, so a dynamic
#          home IP will start failing the moment your ISP rotates it.
#   2. Copy the generated API key into SMARTAPI_KEY
#   3. SMARTAPI_CLIENT_CODE is your Angel One client id (the login id)
#   4. SMARTAPI_PIN is your 4-digit trading PIN
#   5. Enable TOTP at https://smartapi.angelone.in/enable-totp and paste the
#      BASE32 SECRET (not the 6-digit code) into SMARTAPI_TOTP_SECRET.
#      The secret is what lets the server generate codes on its own; a one-off
#      code would expire in 30 seconds.
#
# These are broker credentials with trading rights. Never commit them.
SMARTAPI_KEY=
SMARTAPI_CLIENT_CODE=
SMARTAPI_PIN=
SMARTAPI_TOTP_SECRET=
