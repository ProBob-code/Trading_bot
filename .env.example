# MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=trading_bot

# Discord Daily Reports (optional)
# --------------------------------
# Leave DISCORD_BOT_TOKEN empty and reporting stays dormant; the app runs
# normally and the opt-in toggle tells users it is unavailable.
#
# Setup:
#   1. https://discord.com/developers/applications -> New Application -> Bot
#   2. Copy the bot token into DISCORD_BOT_TOKEN below (NEVER commit it)
#   3. OAuth2 -> URL Generator -> scope "bot", permissions
#      "Manage Channels" + "Send Messages" -> invite it to your server
#   4. DISCORD_GUILD_ID is your server id (enable Developer Mode in Discord,
#      right-click the server -> Copy Server ID)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1393915763588468767
DISCORD_REPORT_HOUR_UTC=21
